From 4e0e8eda68899cbb15133f314085940407651ce2 Mon Sep 17 00:00:00 2001
From: Alessandro Astone <ales.astone@gmail.com>
Date: Sun, 15 May 2022 12:41:25 +0200
Subject: [PATCH] Make tinyxml2 apex_available

Included from libhidlbase, so whitelist it for all the apexes that
use libhidlbase

Change-Id: I68e48abe730223e3227f3855f7155a6a678b2c5d
---
 Android.bp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/Android.bp b/Android.bp
index 1d729ef..e4cf42a 100644
--- a/Android.bp
+++ b/Android.bp
@@ -74,13 +74,20 @@ cc_library {
 
     export_include_dirs: ["."],
 
-    min_sdk_version: "S",
+    min_sdk_version: "29",
 
     apex_available: [
         "com.android.art",
         "com.android.art.debug",
         "com.android.runtime", // used by linkerconfig
         "//apex_available:platform", // For odsign.
+        "com.android.neuralnetworks",
+        "test_com.android.neuralnetworks",
+        "com.android.btservices",
+        "com.android.media",
+        "com.android.media.swcodec",
+        "com.android.tethering",
+        "com.android.nfcservices",
     ],
 }
 
